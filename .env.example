# Maya 환경변수 예시 — 복사해서 .env 로 쓰세요 (.env 는 커밋되지 않습니다)
#   cp .env.example .env
#   # 값을 채운 뒤
#   ./scripts/run_maya_backend.sh
#
# 우선순위: 이미 셸에 export 된 값 > .env 값 > 스크립트 기본값

# ── 대화 LLM ────────────────────────────────────────────────
# cloud | private | local
#   cloud   = OpenRouter 등 OpenAI 호환 원격 API (가장 빠름, 키 필요)
#   private = 자체 게이트웨이 (privseai.com/privseai/llm/v1)
#   local   = Ollama (키 불필요, 이 맥에서는 27B prefill 이 40초라 대화에 부적합)
MAYA_LLM_PROVIDER=cloud

# cloud(OpenRouter) 예시
OPENAI_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=

# OpenAI 직접 사용 시
# OPENAI_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# private(자체 게이트웨이) 사용 시
# MAYA_LLM_PROVIDER=private
# MAYA_PRIVSEAI_BASE=https://privseai.com/privseai/llm/v1
# OPENAI_API_KEY=

# local(Ollama) 사용 시 — MAYA_LOCAL_LLM_MODEL 을 비우면 설치된 모델을 자동 감지
# MAYA_LLM_PROVIDER=local
# OPENAI_BASE=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen3:1.7b
# OPENAI_API_KEY=ollama

# 원격 LLM 타임아웃 (초)
MAYA_LLM_TIMEOUT_S=30

# ── 응답 길이 / 속도 ────────────────────────────────────────
# 로컬 모델이 느릴 때 목표 응답 시간으로 max_tokens 를 제한한다.
# (설정하지 않으면 persona pace 값 그대로 사용)
# MAYA_LLM_TPS=12
# MAYA_LLM_TURN_BUDGET_S=12
MAYA_CONTEXT_TURNS=8

# ── TTS ────────────────────────────────────────────────────
# piper(로컬, 0.01s) | pocket | voxcpm-api(원격 클론, 콜드스타트 16~46s)
TTS_ENGINE=piper
MAYA_TTS_WORKERS=2

# 클론 음성(voxcpm)을 쓰려면 아래 세 조건이 모두 필요합니다.
# MAYA_VOXCPM_ACTIVE=1
# MAYA_VOXCPM_HF_TOKEN=
# VOXCPM_REF_WAV=maya/models/tts/reference/clip_ref_speaker_a.wav

# ── STT ────────────────────────────────────────────────────
# SenseVoice 워커용 파이썬 (torch 가 있는 venv)
# MAYA_STT_WORKER_PYTHON=.venv-voicemem/bin/python

# ── 서버 ───────────────────────────────────────────────────
MAYA_WS_PORT=8788
MAYA_PERSONA=lyra_vex
MAYA_LOG_LEVEL=INFO

# ── RAG (선택) ─────────────────────────────────────────────
# MAYA_RAG_ENABLED=1
